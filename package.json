{
  "name": "blackboard-text",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "Local-first PWA and personal browser extension for quiet note taking.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && node scripts/check.mjs",
    "test": "node --test tests/core.test.mjs",
    "verify": "npm run lint && npm run test && npm run build && node scripts/verify-dist.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0"
  }
}
