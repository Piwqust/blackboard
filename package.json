{
  "name": "blackboard-text",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "A quiet, local-first place to think: a notes web app (PWA) and personal browser extension.",
  "license": "MIT",
  "homepage": "https://piwqust.github.io/blackboard/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piwqust/blackboard.git"
  },
  "bugs": {
    "url": "https://github.com/Piwqust/blackboard/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . && node scripts/check.mjs",
    "test": "node --test tests/core.test.mjs tests/short-links.test.mjs tests/improvements.test.mjs",
    "verify": "npm run lint && npm run test && npm run build && node scripts/verify-dist.mjs",
    "test:browser": "playwright test",
    "shares:dev": "wrangler dev --config backend/short-links/wrangler.jsonc",
    "shares:check": "wrangler deploy --dry-run --config backend/short-links/wrangler.jsonc",
    "shares:deploy": "wrangler deploy --config backend/short-links/wrangler.jsonc",
    "test:shares": "node scripts/test-short-links.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "wrangler": "^4.135.0"
  }
}
